# Salin jadi `secrets.toml` di folder yang sama untuk menjalankan app lokal
# (berkas itu sudah di-gitignore). Untuk hosting di Streamlit Community Cloud,
# JANGAN commit berkas ini — tempel isinya di dashboard app:
#   Manage app > Settings > Secrets
#
# PENTING: kunci harus di level ATAS (tanpa [section]). Streamlit hanya
# mempromosikan kunci top-level bertipe string/int/float ke environment
# variable, dan `auth.py` membacanya lewat os.environ. Kalau ditaruh di bawah
# [admin], auth.py TIDAK akan melihatnya dan jatuh ke default dev.

ADMIN_USERNAME = "ganti-username-admin"
ADMIN_PASSWORD = "ganti-dengan-kata-sandi-panjang-dan-acak"
